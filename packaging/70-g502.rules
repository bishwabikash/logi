# Let the logged-in user talk to the G502's HID++ endpoint without root.
# uaccess hands access to the active local session via systemd-logind.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c08b", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c08d", MODE="0660", TAG+="uaccess"
